# EmailCheck - Environment Variables Configuration (.env.example)
# Copy this file to .env for local testing.
# In production on Render, configure these in Dashboard -> Environment Variables.

# 1. Selected HTTPS Email Verification Provider
# Options: 'abstract' (default), 'hunter', 'zerobounce', or 'none' (local fallback only)
EMAIL_VERIFICATION_PROVIDER=abstract

# 2. Provider API Key (Required for live recipient inbox verification over HTTPS port 443)
# - Abstract API: Sign up at https://www.abstractapi.com/api/email-verification-validation-api (100 free requests/month)
# - Hunter.io: Sign up at https://hunter.io/api/email-verifier (25 free requests/month)
# - ZeroBounce: Sign up at https://www.zerobounce.net/ (100 free requests/month)
EMAIL_VERIFICATION_API_KEY=your_api_key_here

# 3. Request timeout in seconds for provider HTTPS API calls
EMAIL_VERIFICATION_TIMEOUT=6.0

# 4. Optional Direct SMTP check (Leave false on Render and cloud hosts where port 25 is restricted)
ENABLE_DIRECT_SMTP=false

# 5. Security and Rate Limiting Limits
MAX_EMAILS_PER_REQUEST=100
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
